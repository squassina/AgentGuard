# Environment configuration for AgentGuard
# Copy to .env for local development

# Application
ENVIRONMENT=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Security (Replace in production)
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars-long
